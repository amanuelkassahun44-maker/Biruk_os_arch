{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/biruk_logo.txt",
    "type": "file",
    "color": {
      "1": "cyan",
      "2": "magenta"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ⚡ "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "format": "Biruk-OS 24.04 LTS (Hacker Edition)"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "Hyprland (Pure Wayland)"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "format": "Kitty (GPU Accelerated)"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "memory",
      "key": "RAM (ZRAM)",
      "format": "{used} / {total} (Ultra-Lightweight <500MB Idle)"
    },
    {
      "type": "custom",
      "key": "AI Co-Pilot",
      "format": "Beti Native v1.0 (Amy 0.75x Synced)"
    },
    "break",
    "colors"
  ]
}
